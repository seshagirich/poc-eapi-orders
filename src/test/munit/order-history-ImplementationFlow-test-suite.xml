				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="order history sapi Request" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:error typeId="HTTP:BAD_REQUEST" />
				</munit-tools:then-return>
			
</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="da835189-116b-4ecb-85b3-d4ae73adc8b9" >
				<munit:payload value="#[MunitTools::getResourceAsString('order-history-errorhandling-request.json')]" mediaType="application/json" />

